# Copy to .env.local for local dev. Real values live only in the host's env settings and .env.local.
# Public (safe for the browser) values use the framework's public prefix; secrets never do.

# PUBLIC — shipped to the browser
VITE_APP_URL=http://localhost:5173

# SECRET — server only
PROVIDER_API_KEY=replace-me
DATABASE_SERVICE_KEY=replace-me
ACCESS_CODES=replace-me
